{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": {
        "pattern": {
          "regexp": "\\[TypeScript\\] (.+)\\((\\d+),(\\d+)\\): (error TS\\d+): (.+)",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "=== OpenKode Build ===",
          "endsPattern": "Build (successful|failed|completed)"
        }
      },
      "isBackground": true,
      "label": "npm: watch",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": {
        "pattern": {
          "regexp": "\\[TypeScript\\] (.+)\\((\\d+),(\\d+)\\): (error TS\\d+): (.+)",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      },
      "label": "npm: compile",
      "group": "build"
    }
  ]
}
