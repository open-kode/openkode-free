{
  "compilerOptions": {
    // JSX support for React components
    "module": "commonjs",
    "target": "ES2020",
    "lib": [
      "ES2020",
      "dom"
    ],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "jsx": "react"
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "out",
    "src/ui/webview/**/*",
    "frontend/**/*"
  ],
  "include": [
    "src/**/*"
  ]
}
